#!/bin/sh
# bbd-backup: build and optionally push the bandwidth history backup file.
# Usage: bbd-backup generate_local | sync

PERSIST_DIR="/etc/bandwidthbydevice"
RUNTIME_DIR="/tmp/bandwidthbydevice"
STATUS_FILE="$RUNTIME_DIR/backup_status.json"
BACKUP_FILE="$RUNTIME_DIR/backup.json"
DEVICES_FILE="$PERSIST_DIR/known_devices"

mkdir -p "$RUNTIME_DIR"

log() { logger -t bbd-backup "$*"; }
cfg() { uci -q get "bandwidthbydevice.backup.$1"; }

write_status() {
    local status="$1" msg="$2" bytes="${3:-0}"
    msg=$(printf '%s' "$msg" | tr -d '\r\n' | sed 's/\\/\\\\/g; s/"/\\"/g')
    local ts
    ts=$(date +%s)
    printf '{"status":"%s","message":"%s","ts":%d,"file_bytes":%s}\n' \
        "$status" "$msg" "$ts" "$bytes" > "$STATUS_FILE"
    local logfile="$RUNTIME_DIR/backup_log.jsonl"
    printf '{"ts":%d,"status":"%s","message":"%s"}\n' "$ts" "$status" "$msg" >> "$logfile"
    local lines
    lines=$(wc -l < "$logfile" 2>/dev/null || echo 0)
    [ "$lines" -gt 20 ] && tail -20 "$logfile" > "$logfile.tmp" && mv "$logfile.tmp" "$logfile"
}

# Build /tmp/bandwidthbydevice/backup.json from on-device daily history.
# Each device gets a "daily" array copied directly from its history_<MAC>.json.
generate_local() {
    [ -f "$DEVICES_FILE" ] || { log "No known devices file"; return 1; }

    local tmpfile
    tmpfile=$(mktemp /tmp/bbd-gen-XXXXXX)

    printf '{"generated":%d,"devices":[' "$(date +%s)" > "$tmpfile"

    local first=1
    while IFS=' ' read -r mac ip hostname; do
        [ -z "$mac" ] && continue

        local safemac
        safemac=$(echo "$mac" | tr -d ':')

        local histfile="$PERSIST_DIR/history_${safemac}.json"
        local daily="[]"
        if [ -f "$histfile" ]; then
            # history file format: {"daily":[...]}  — extract the array
            local extracted
            extracted=$(tr -d '\n' < "$histfile" | sed 's/^{"daily"://;s/}$//')
            [ -n "$extracted" ] && daily="$extracted"
        fi

        local safe_hn
        safe_hn=$(printf '%s' "$hostname" | sed 's/\\/\\\\/g;s/"/\\"/g')

        [ "$first" -eq 0 ] && printf ',' >> "$tmpfile"
        printf '{"mac":"%s","hostname":"%s","daily":%s}' \
            "$mac" "$safe_hn" "$daily" >> "$tmpfile"
        first=0
    done < "$DEVICES_FILE"

    printf ']}\n' >> "$tmpfile"
    mv "$tmpfile" "$BACKUP_FILE"

    wc -c < "$BACKUP_FILE" 2>/dev/null || echo 0
}

# Generate the backup file locally then push it to the remote server via SCP,
# replacing any existing copy.
do_sync() {
    local host port user pass path
    host=$(cfg host)
    [ -z "$host" ] && { write_status "error" "No host configured"; exit 1; }
    port=$(cfg port); port=${port:-22}
    user=$(cfg username)
    [ -z "$user" ] && { write_status "error" "No username configured"; exit 1; }
    pass=$(cfg password)
    path=$(cfg remote_path); path="${path%/}"

    if ! which sshpass >/dev/null 2>&1; then
        write_status "error" "sshpass not installed — run: opkg install sshpass"
        exit 1
    fi

    generate_local || { write_status "error" "Failed to generate backup file"; exit 1; }

    local dest_file
    if [ -n "$path" ]; then
        dest_file="${path}/BandwidthByDevice.json"
    else
        dest_file="BandwidthByDevice.json"
    fi

    sshpass -p "$pass" ssh \
        -p "$port" -o StrictHostKeyChecking=no \
        "${user}@${host}" "mkdir -p '$(dirname "$dest_file")'" >/dev/null 2>&1

    local rc output
    output=$(sshpass -p "$pass" scp \
        -P "$port" -o StrictHostKeyChecking=no \
        "$BACKUP_FILE" \
        "${user}@${host}:${dest_file}" 2>&1)
    rc=$?

    local file_bytes
    file_bytes=$(wc -c < "$BACKUP_FILE" 2>/dev/null || echo 0)

    if [ "$rc" -eq 0 ]; then
        log "synced $(wc -c < "$BACKUP_FILE" 2>/dev/null || echo 0) bytes to ${user}@${host}:${dest_file}"
        write_status "ok" "Synced to ${user}@${host}:${dest_file}" "$file_bytes"
    else
        write_status "error" "Sync failed: $output" "0"
        exit 1
    fi
}

case "$1" in
  generate_local) generate_local ;;
  sync)           do_sync        ;;
  *) echo "Usage: $0 generate_local|sync"; exit 1 ;;
esac
