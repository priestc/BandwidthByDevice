#!/bin/sh

case "$1" in
  list)
    printf '{"devices":{},"stats":{"mac":"String"},"history":{"mac":"String"},"get_backup_config":{},"set_backup_config":{"host":"String","port":"String","username":"String","password":"String","remote_path":"String","mode":"String","smarthome_url":"String","smarthome_token":"String"},"run_backup":{},"get_backup_status":{},"get_storage_info":{},"get_backup_data":{},"get_smarthome_log":{},"get_backup_log":{}}\n'
    ;;
  call)
    INPUT=$(cat)

    case "$2" in

      devices)
        _cpu_prev="/tmp/bandwidthbydevice/cpu_stat_prev"
        set -- $(head -1 /proc/stat)
        shift
        _active=$(($1 + $2 + $3 + $6 + $7 + ${8:-0}))
        _total=$((_active + $4 + $5))
        _cpu_pct=0
        if [ -f "$_cpu_prev" ]; then
          read -r _pt _pa < "$_cpu_prev"
          _dt=$((_total  - _pt))
          _da=$((_active - _pa))
          [ "$_dt" -gt 0 ] && _cpu_pct=$(awk "BEGIN{printf \"%d\", $_da*100/$_dt}")
        fi
        printf '%d %d\n' "$_total" "$_active" > "$_cpu_prev"
        _json=$(cat /tmp/bandwidthbydevice/current.json 2>/dev/null)
        if [ -n "$_json" ]; then
          printf '{"cpu_pct":%d,%s\n' "$_cpu_pct" "${_json#\{}"
        else
          printf '{"cpu_pct":%d,"ts":0,"devices":[]}\n' "$_cpu_pct"
        fi
        ;;

      stats)
        safemac=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr -d ':')
        [ -n "$safemac" ] && \
          cat "/tmp/bandwidthbydevice/stats_${safemac}.json" 2>/dev/null || \
          printf '{"samples":[]}\n'
        ;;

      history)
        safemac=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr -d ':')
        [ -n "$safemac" ] && \
          cat "/etc/bandwidthbydevice/history_${safemac}.json" 2>/dev/null || \
          printf '{"daily":[]}\n'
        ;;

      get_backup_config)
        printf '{"host":"%s","port":"%s","username":"%s","remote_path":"%s","mode":"%s","smarthome_url":"%s","smarthome_token":"%s"}\n' \
          "$(uci -q get bandwidthbydevice.backup.host           || echo '')" \
          "$(uci -q get bandwidthbydevice.backup.port           || echo 22)" \
          "$(uci -q get bandwidthbydevice.backup.username       || echo '')" \
          "$(uci -q get bandwidthbydevice.backup.remote_path    || echo '')" \
          "$(uci -q get bandwidthbydevice.backup.mode           || echo 'none')" \
          "$(uci -q get bandwidthbydevice.backup.smarthome_url  || echo '')" \
          "$(uci -q get bandwidthbydevice.backup.smarthome_token || echo '')"
        ;;

      set_backup_config)
        uci -q get bandwidthbydevice.backup >/dev/null 2>&1 || \
          uci set bandwidthbydevice.backup=backup
        for key in host port username password remote_path smarthome_url smarthome_token; do
          val=$(echo "$INPUT" | jsonfilter -e "@.${key}" 2>/dev/null)
          if [ -n "$val" ]; then
            uci set "bandwidthbydevice.backup.${key}=${val}"
          elif [ "$key" = "remote_path" ]; then
            uci -q delete "bandwidthbydevice.backup.remote_path"
          fi
        done
        mode=$(echo "$INPUT" | jsonfilter -e '@.mode' 2>/dev/null)
        mode=${mode:-none}
        uci set "bandwidthbydevice.backup.mode=${mode}"
        if [ "$mode" = "remote" ]; then
          mkdir -p /etc/crontabs
          sed -i '/\/usr\/bin\/bbd-backup/d' /etc/crontabs/root 2>/dev/null
          printf '0 * * * * /usr/bin/bbd-backup sync\n' >> /etc/crontabs/root
          /etc/init.d/cron enable 2>/dev/null
          /etc/init.d/cron reload 2>/dev/null || /etc/init.d/cron start 2>/dev/null
        else
          sed -i '/\/usr\/bin\/bbd-backup/d' /etc/crontabs/root 2>/dev/null
          /etc/init.d/cron reload 2>/dev/null
        fi
        uci commit bandwidthbydevice
        printf '{"result":"ok"}\n'
        ;;

      run_backup)
        /usr/bin/bbd-backup sync >/dev/null 2>&1
        cat /tmp/bandwidthbydevice/backup_status.json 2>/dev/null || \
          printf '{"status":"error","message":"Script produced no output","ts":0,"file_bytes":0}\n'
        ;;

      get_backup_status)
        cat /tmp/bandwidthbydevice/backup_status.json 2>/dev/null || \
          printf '{"status":"never","message":"No backup has been run yet","ts":0,"file_bytes":0}\n'
        ;;

      get_storage_info)
        /usr/bin/bbd-backup generate_local >/dev/null 2>&1
        _file="/tmp/bandwidthbydevice/backup.json"
        _file_bytes=0
        [ -f "$_file" ] && _file_bytes=$(wc -c < "$_file" 2>/dev/null || echo 0)
        _last_status=$(cat /tmp/bandwidthbydevice/backup_status.json 2>/dev/null \
          || printf '{"status":"never","ts":0,"file_bytes":0}')
        printf '{"file_bytes":%d,"last_sync":%s}\n' "$_file_bytes" "$_last_status"
        ;;

      get_backup_data)
        /usr/bin/bbd-backup generate_local >/dev/null 2>&1
        _data=$(cat /tmp/bandwidthbydevice/backup.json 2>/dev/null || echo '{}')
        printf '{"filename":"BandwidthByDevice.json","data":%s}\n' "$_data"
        ;;

      get_smarthome_log)
        _log="/tmp/bandwidthbydevice/smarthome_log.jsonl"
        if [ -f "$_log" ] && [ -s "$_log" ]; then
          _entries=$(tail -20 "$_log" | tr '\n' ',' | sed 's/,$//')
          printf '{"entries":[%s]}\n' "$_entries"
        else
          printf '{"entries":[]}\n'
        fi
        ;;

      get_backup_log)
        _log="/tmp/bandwidthbydevice/backup_log.jsonl"
        if [ -f "$_log" ] && [ -s "$_log" ]; then
          _entries=$(tail -20 "$_log" | tr '\n' ',' | sed 's/,$//')
          printf '{"entries":[%s]}\n' "$_entries"
        else
          printf '{"entries":[]}\n'
        fi
        ;;

      *)
        printf '{"error":"unknown method"}\n'
        ;;
    esac
    ;;
esac
